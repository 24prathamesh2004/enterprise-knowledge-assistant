# Copy this file to .env and fill in your credentials. NEVER commit the real .env.

# --- Required: Groq API key ---
GROQ_API_KEY=gsk_your_key_here

# --- Optional: model overrides (defaults in config.py) ---
# EKA_GEN_MODEL=llama-3.3-70b-versatile
# EKA_JUDGE_MODEL=llama-3.3-70b-versatile
# EKA_EMBED_MODEL=all-MiniLM-L6-v2

# --- Optional: LangSmith tracing (leave unset to use manual logging only) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=enterprise-knowledge-assistant
