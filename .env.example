# Copy this file to .env and fill in your key. NEVER commit the real .env.

# --- Required: Groq API key (generation + RAGAS judge) ---
GROQ_API_KEY=gsk_your_key_here

# --- Optional: model overrides (defaults are set in config.py) ---
# EKA_GEN_MODEL=openai/gpt-oss-20b
# EKA_JUDGE_MODEL=openai/gpt-oss-120b
# EKA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Optional: LangSmith tracing (leave unset to use manual logging only) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=enterprise-knowledge-assistant
