# Copy to .env and fill in. NEVER commit the real .env.

# --- Required: Anthropic Claude (generation + RAGAS judge) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional: model overrides ---
EKA_GEN_MODEL=claude-haiku-4-5
EKA_JUDGE_MODEL=claude-sonnet-5

# --- Optional: LangSmith observability (leave blank to use manual logging only) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-knowledge-assistant
